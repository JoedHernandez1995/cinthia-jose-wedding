# Supabase project settings (Project Settings → API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-only, NEVER prefix with NEXT_PUBLIC_ and never
# import it from a "use client" file. Used exclusively by lib/supabase/admin.ts.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL used to build each guest's personal invitation link
# (https://<this>/i/<token>) and check-in QR URLs. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend (resend.com) — sends the RSVP confirmation PDF email. Requires a
# verified sending domain (SPF/DKIM) for real deliverability.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Cinthia & José <confirmaciones@tudominio.com>"

# Sentry (sentry.io) — error tracking. Optional: without a DSN, error reporting is a no-op and
# everything else works normally. NEXT_PUBLIC_ because the client-side SDK needs it in the
# browser bundle too.
NEXT_PUBLIC_SENTRY_DSN=

# Only needed to upload source maps (readable stack traces in Sentry) during `next build` —
# create at sentry.io/settings/account/api/auth-tokens. Leave unset to skip source map upload.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
